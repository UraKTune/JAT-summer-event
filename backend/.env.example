# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── PostgreSQL (Render) ──────────────────────────────────────
# Lấy từ Render Dashboard → PostgreSQL service → Internal Connection String
DATABASE_URL=postgresql://user:password@host/dbname

# ── osu! OAuth ───────────────────────────────────────────────
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=https://jat-summer-event.onrender.com/callback

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=https://UraKTune.github.io/JAT-summer-event

# ── Session ──────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-32-chars-min

# ── Admin osu! UIDs (cách nhau bằng dấu phẩy) ───────────────
ADMIN_UIDS=12345678,87654321

# ── Beatmap IDs (competition) ────────────────────────────────
BEATMAP_ID_0=
BEATMAP_ID_1=
BEATMAP_ID_2=
BEATMAP_ID_3=
BEATMAP_ID_4=
